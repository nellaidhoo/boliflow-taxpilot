NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boliflow?schema=public
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=local-development-secret-change-before-production-32chars
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=boliflow-private-documents
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
WEB_ORIGINS=http://localhost:5173
