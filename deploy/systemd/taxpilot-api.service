[Unit]
Description=TaxPilot API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=taxpilot
Group=taxpilot
WorkingDirectory=/opt/taxpilot/app/backend
EnvironmentFile=/etc/taxpilot/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/taxpilot/app/backend/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
